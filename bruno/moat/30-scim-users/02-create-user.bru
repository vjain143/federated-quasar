meta {
  name: Create User
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/scim/v2/Users
  body: json
  auth: none
}

headers {
  Content-Type: application/scim+json
  Accept: application/scim+json
}

body:json {
  {
    "schemas": [
      "urn:ietf:params:scim:schemas:core:2.0:User"
    ],
    "id": "{{scim_user_id}}",
    "userName": "{{scim_user_name}}",
    "name": {
      "givenName": "{{scim_user_given_name}}",
      "familyName": "{{scim_user_family_name}}"
    },
    "emails": [
      {
        "value": "{{scim_user_email}}",
        "primary": true
      }
    ],
    "active": true,
    "entitlements": [
      {
        "value": "{{scim_user_entitlement}}"
      }
    ]
  }
}
