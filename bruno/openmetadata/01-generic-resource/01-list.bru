meta {
  name: List Resources
  type: http
  seq: 1
}

get {
  url: {{base_url}}{{resource_path}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

headers {
  Accept: application/json
}

query {
  limit: {{limit}}
  include: {{include}}
  fields: {{fields}}
  before: {{before}}
  after: {{after}}
}
