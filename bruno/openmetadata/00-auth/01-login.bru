meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/users/login
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "email": "{{om_email}}",
    "password": "{{om_password_b64}}"
  }
}
