coordinator=true
node-scheduler.include-coordinator=true
http-server.http.port=8080
query.max-memory=5GB
query.max-memory-per-node=1GB
query.max-total-memory-per-node=2GB
discovery.uri=http://trino:8080
http-server.authentication.type=PASSWORD
http-server.authentication.opa.policy-server-url=http://opa:8181/v1/data/trino/authz
sql.default-function-catalog=ai
sql.default-function-schema=default
sql.path=llm.ai
# Dynamic catalog
catalog.config-dir=/etc/trino/catalog
enable-dynamic-catalogs=true
